{
  "name": "logiclens",
  "displayName": "LogicLens",
  "description": "Step-by-step code walkthroughs and line questions using the AI you already have.",
  "version": "0.0.1",
  "publisher": "logiclens-dev",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.3.4",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "logiclens.explainFile",
        "title": "Explain File",
        "category": "LogicLens",
        "icon": "$(sparkle)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "logiclens.stop",
        "title": "Stop",
        "category": "LogicLens",
        "icon": "$(debug-stop)"
      },
      {
        "command": "logiclens.continue",
        "title": "Continue Explanation",
        "category": "LogicLens",
        "icon": "$(debug-continue)"
      },
      {
        "command": "logiclens.nextStep",
        "title": "Next Step",
        "category": "LogicLens",
        "icon": "$(arrow-down)"
      },
      {
        "command": "logiclens.previousStep",
        "title": "Previous Step",
        "category": "LogicLens",
        "icon": "$(arrow-up)"
      },
      {
        "command": "logiclens.clearFocus",
        "title": "Clear Step Highlight",
        "category": "LogicLens"
      },
      {
        "command": "logiclens.showAllSteps",
        "title": "Show All Steps",
        "category": "LogicLens",
        "icon": "$(unfold)"
      },
      {
        "command": "logiclens.focusStep",
        "title": "Show Step",
        "category": "LogicLens"
      },
      {
        "command": "logiclens.closeExplanation",
        "title": "Close Explanation",
        "category": "LogicLens",
        "icon": "$(close)"
      },
      {
        "command": "logiclens.viewTerms",
        "title": "View Terms of Use",
        "category": "LogicLens"
      },
      {
        "command": "logiclens.askAtLine",
        "title": "Ask About This Line",
        "category": "LogicLens",
        "icon": "$(comment-discussion)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "logiclens.submitQuestion",
        "title": "Ask",
        "category": "LogicLens"
      },
      {
        "command": "logiclens.stopQuestion",
        "title": "Stop",
        "category": "LogicLens",
        "icon": "$(debug-stop)"
      },
      {
        "command": "logiclens.copyAnswer",
        "title": "Copy Answer",
        "category": "LogicLens",
        "icon": "$(copy)"
      },
      {
        "command": "logiclens.regenerateAnswer",
        "title": "Regenerate Answer",
        "category": "LogicLens",
        "icon": "$(refresh)"
      },
      {
        "command": "logiclens.deleteQuestionComment",
        "title": "Delete",
        "category": "LogicLens",
        "icon": "$(trash)"
      },
      {
        "command": "logiclens.askStep",
        "title": "Ask About This Step",
        "category": "LogicLens",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "logiclens.askConcept",
        "title": "Ask About Concept",
        "category": "LogicLens"
      },
      {
        "command": "logiclens.revealLine",
        "title": "Go to Line",
        "category": "LogicLens"
      },
      {
        "command": "logiclens.clearThreadsInFile",
        "title": "Clear Threads in File",
        "category": "LogicLens"
      },
      {
        "command": "logiclens.clearAllThreads",
        "title": "Clear All Threads",
        "category": "LogicLens"
      },
      {
        "command": "logiclens.selectProvider",
        "title": "Select AI Provider",
        "category": "LogicLens",
        "icon": "$(sparkle)"
      },
      {
        "command": "logiclens.selectModel",
        "title": "Select Model",
        "category": "LogicLens"
      },
      {
        "command": "logiclens.resetDataNotices",
        "title": "Reset Data Notices",
        "category": "LogicLens"
      },
      {
        "command": "logiclens.regenerateWith",
        "title": "Regenerate with…",
        "category": "LogicLens",
        "icon": "$(versions)"
      },
      {
        "command": "logiclens.explainSelection",
        "title": "Explain Selection",
        "category": "LogicLens",
        "icon": "$(sparkle)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "logiclens.explainSymbol",
        "title": "Explain Symbol",
        "category": "LogicLens",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "logiclens.setDepth",
        "title": "Set Explanation Depth",
        "category": "LogicLens"
      },
      {
        "command": "logiclens.setAudience",
        "title": "Set Audience",
        "category": "LogicLens"
      },
      {
        "command": "logiclens.setJargon",
        "title": "Set Jargon Level",
        "category": "LogicLens"
      },
      {
        "command": "logiclens.adjustExplanation",
        "title": "Adjust Explanation…",
        "category": "LogicLens",
        "icon": "$(settings)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "logiclens.explainFile",
          "when": "(resourceScheme == file || resourceScheme == untitled) && !logiclens.fileExcluded",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "logiclens.stop",
          "when": "logiclens.busy"
        },
        {
          "command": "logiclens.focusStep",
          "when": "false"
        },
        {
          "command": "logiclens.continue",
          "when": "false"
        },
        {
          "command": "logiclens.nextStep",
          "when": "logiclens.walkthroughActive"
        },
        {
          "command": "logiclens.previousStep",
          "when": "logiclens.walkthroughActive"
        },
        {
          "command": "logiclens.clearFocus",
          "when": "logiclens.stepFocused"
        },
        {
          "command": "logiclens.showAllSteps",
          "when": "logiclens.walkthroughActive"
        },
        {
          "command": "logiclens.submitQuestion",
          "when": "false"
        },
        {
          "command": "logiclens.stopQuestion",
          "when": "false"
        },
        {
          "command": "logiclens.copyAnswer",
          "when": "false"
        },
        {
          "command": "logiclens.regenerateAnswer",
          "when": "false"
        },
        {
          "command": "logiclens.deleteQuestionComment",
          "when": "false"
        },
        {
          "command": "logiclens.askStep",
          "when": "false"
        },
        {
          "command": "logiclens.askConcept",
          "when": "false"
        },
        {
          "command": "logiclens.revealLine",
          "when": "false"
        },
        {
          "command": "logiclens.regenerateWith",
          "when": "false"
        },
        {
          "command": "logiclens.explainSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "logiclens.adjustExplanation",
          "when": "false"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "logiclens.stop",
          "when": "commentController == logiclens && commentThread == streaming",
          "group": "inline@1"
        },
        {
          "command": "logiclens.continue",
          "when": "commentController == logiclens && commentThread == continuable",
          "group": "inline@1"
        },
        {
          "command": "logiclens.explainFile",
          "when": "commentController == logiclens && commentThread =~ /^(finished|continuable)$/",
          "group": "inline@2"
        },
        {
          "command": "logiclens.showAllSteps",
          "when": "commentController == logiclens && commentThread =~ /^(streaming|finished|continuable)$/",
          "group": "inline@3"
        },
        {
          "command": "logiclens.closeExplanation",
          "when": "commentController == logiclens && commentThread =~ /^(streaming|finished|continuable)$/",
          "group": "inline@4"
        },
        {
          "command": "logiclens.askStep",
          "when": "commentController == logiclens && commentThread == step",
          "group": "inline@1"
        },
        {
          "command": "logiclens.stopQuestion",
          "when": "commentController == logiclens && commentThread == question-busy",
          "group": "inline@1"
        },
        {
          "command": "logiclens.regenerateWith",
          "when": "commentController == logiclens && commentThread =~ /^(finished|continuable)$/",
          "group": "inline@2"
        },
        {
          "command": "logiclens.adjustExplanation",
          "when": "commentController == logiclens && commentThread =~ /^(finished|continuable)$/",
          "group": "inline@3"
        }
      ],
      "editor/context": [
        {
          "command": "logiclens.explainFile",
          "when": "(resourceScheme == file || resourceScheme == untitled) && !logiclens.fileExcluded",
          "group": "logiclens@1"
        },
        {
          "command": "logiclens.explainSelection",
          "when": "(resourceScheme == file || resourceScheme == untitled) && !logiclens.fileExcluded && editorHasSelection",
          "group": "logiclens@1"
        },
        {
          "command": "logiclens.askAtLine",
          "when": "(resourceScheme == file || resourceScheme == untitled) && !logiclens.fileExcluded",
          "group": "logiclens@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "logiclens.submitQuestion",
          "when": "commentController == logiclens",
          "group": "inline"
        }
      ],
      "comments/comment/title": [
        {
          "command": "logiclens.copyAnswer",
          "when": "commentController == logiclens && comment == answer",
          "group": "inline@1"
        },
        {
          "command": "logiclens.regenerateAnswer",
          "when": "commentController == logiclens && comment == answer",
          "group": "inline@2"
        },
        {
          "command": "logiclens.deleteQuestionComment",
          "when": "commentController == logiclens && comment =~ /^(question|answer)$/",
          "group": "inline@3"
        }
      ],
      "explorer/context": [
        {
          "command": "logiclens.explainFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder && !listMultiSelection",
          "group": "logiclens@1"
        }
      ]
    },
    "configuration": {
      "title": "LogicLens",
      "properties": {
        "logiclens.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.env*",
            "**/*.pem",
            "**/*.key",
            "**/id_rsa*",
            "**/secrets/**",
            "**/*.tfvars"
          ],
          "scope": "resource",
          "markdownDescription": "Glob patterns for files LogicLens never reads or sends. Workspace values are added to your user values; they cannot remove them. `.logiclensignore` at the workspace root (gitignore syntax) also applies."
        },
        "logiclens.maxLines": {
          "type": "number",
          "default": 2000,
          "minimum": 1,
          "scope": "resource",
          "description": "Files with more lines than this are not sent whole."
        },
        "logiclens.secrets.action": {
          "type": "string",
          "enum": [
            "skip-lines",
            "refuse-file"
          ],
          "enumDescriptions": [
            "Replace each line with a possible secret by a marker and send the rest.",
            "Send nothing when a possible secret is found."
          ],
          "default": "skip-lines",
          "scope": "application",
          "description": "What to do when the local secret scan finds a possible secret. The scan cannot be turned off."
        },
        "logiclens.debug.logPrompts": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Log prompts and responses (with secrets redacted) to the LogicLens output channel. Off by default."
        },
        "logiclens.focusDimming": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Dim lines outside the focused step."
        },
        "logiclens.followCursor": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "While a step is focused, move the highlight to the step under the cursor."
        },
        "logiclens.provider": {
          "type": "string",
          "enum": [
            "auto",
            "vscode-lm",
            "claude-code"
          ],
          "enumDescriptions": [
            "The first ready provider, in this order: VS Code language models, then Claude Code.",
            "VS Code language models from installed extensions, such as GitHub Copilot.",
            "The Claude Code CLI, run headless with its tools turned off."
          ],
          "default": "auto",
          "scope": "application",
          "markdownDescription": "Which AI tool LogicLens sends code to. `auto` uses the first ready provider. LogicLens never switches provider on its own; pick one with **LogicLens: Select AI Provider** or the status bar."
        },
        "logiclens.model": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Model ID for the chosen provider, as **LogicLens: Select Model** lists it. Empty uses the provider's default."
        },
        "logiclens.cli.claudePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the Claude Code `claude` binary. Empty uses `claude` on `PATH`. Machine scope: workspace settings cannot change it."
        },
        "logiclens.cli.timeoutSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 10,
          "scope": "application",
          "description": "Stop a CLI provider request after this many seconds."
        },
        "logiclens.depth": {
          "type": "string",
          "enum": [
            "overview",
            "standard",
            "detailed"
          ],
          "enumDescriptions": [
            "The big picture in 3 to 5 steps.",
            "The default: 3 to 15 steps.",
            "Line by line through dense code: 8 to 25 steps."
          ],
          "default": "standard",
          "scope": "resource",
          "description": "How many steps a walkthrough has and how much detail each gives."
        },
        "logiclens.audience": {
          "type": "string",
          "enum": [
            "eli5",
            "newcomer",
            "practitioner",
            "expert"
          ],
          "enumDescriptions": [
            "Explain like I'm five: everyday words and one analogy per step.",
            "Names concepts and explains each the first time.",
            "Assumes working knowledge of the language.",
            "Terse: intent, invariants, edge cases, performance."
          ],
          "default": "practitioner",
          "scope": "resource",
          "description": "Who the explanation is written for. Answers to questions follow it too."
        },
        "logiclens.jargon": {
          "type": "string",
          "enum": [
            "auto",
            "avoid",
            "define",
            "use"
          ],
          "enumDescriptions": [
            "Follows the audience.",
            "Plain words instead of technical terms.",
            "Technical terms with a short definition the first time.",
            "Technical terms without definitions."
          ],
          "default": "auto",
          "scope": "resource",
          "description": "How technical terms are handled."
        },
        "logiclens.explanationLanguage": {
          "type": "string",
          "default": "auto",
          "scope": "application",
          "markdownDescription": "Language for explanations, as a BCP 47 tag such as `de` or `pt-BR`. `auto` follows VS Code's display language. Code identifiers are never translated."
        },
        "logiclens.codeLens.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Show \"Explain\" above functions and classes."
        }
      }
    },
    "keybindings": [
      {
        "command": "logiclens.explainFile",
        "key": "ctrl+alt+e f",
        "mac": "cmd+alt+e f",
        "when": "editorTextFocus"
      },
      {
        "command": "logiclens.explainSelection",
        "key": "ctrl+alt+e s",
        "mac": "cmd+alt+e s",
        "when": "editorHasSelection"
      },
      {
        "command": "logiclens.nextStep",
        "key": "alt+]",
        "mac": "alt+]",
        "when": "logiclens.walkthroughActive"
      },
      {
        "command": "logiclens.previousStep",
        "key": "alt+[",
        "mac": "alt+[",
        "when": "logiclens.walkthroughActive"
      },
      {
        "command": "logiclens.clearFocus",
        "key": "escape",
        "mac": "escape",
        "when": "logiclens.stepFocused && editorTextFocus && !suggestWidgetVisible && !findWidgetVisible && !inSnippetMode && !hasMultipleSelections"
      },
      {
        "command": "logiclens.askAtLine",
        "key": "ctrl+alt+e q",
        "mac": "cmd+alt+e q",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:release": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/integration/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "pretest:integration": "pnpm build && tsc -p test/integration/tsconfig.json",
    "test:integration": "vscode-test",
    "eval": "esbuild test/eval/run.ts --bundle --platform=node --format=cjs --outfile=out/eval/run.js --log-level=warning && node out/eval/run.js",
    "package": "pnpm build:release && vsce package --no-dependencies --no-rewrite-relative-links --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "ignore": "^7.0.14",
    "picomatch": "^4.0.7"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "LogicLens never sends code from a restricted workspace. Trust the workspace to explain code."
    }
  }
}
