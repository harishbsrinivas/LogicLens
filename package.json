{
  "name": "logiclens",
  "displayName": "LogicLens",
  "description": "Step-by-step code walkthroughs and line questions using the AI you already have.",
  "version": "0.0.1",
  "publisher": "logiclens-dev",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.3.4",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "logiclens.explainFile",
        "title": "Explain File",
        "category": "LogicLens",
        "icon": "$(sparkle)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "logiclens.stop",
        "title": "Stop",
        "category": "LogicLens",
        "icon": "$(debug-stop)"
      },
      {
        "command": "logiclens.viewTerms",
        "title": "View Terms of Use",
        "category": "LogicLens"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "logiclens.explainFile",
          "when": "(resourceScheme == file || resourceScheme == untitled) && !logiclens.fileExcluded",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "logiclens.stop",
          "when": "logiclens.busy"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "logiclens",
          "title": "LogicLens",
          "icon": "media/logiclens.svg"
        }
      ]
    },
    "views": {
      "logiclens": [
        {
          "type": "webview",
          "id": "logiclens.panel",
          "name": "LogicLens"
        }
      ]
    },
    "configuration": {
      "title": "LogicLens",
      "properties": {
        "logiclens.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.env*",
            "**/*.pem",
            "**/*.key",
            "**/id_rsa*",
            "**/secrets/**",
            "**/*.tfvars"
          ],
          "scope": "resource",
          "markdownDescription": "Glob patterns for files LogicLens never reads or sends. Workspace values are added to your user values; they cannot remove them. `.logiclensignore` at the workspace root (gitignore syntax) also applies."
        },
        "logiclens.maxLines": {
          "type": "number",
          "default": 2000,
          "minimum": 1,
          "scope": "resource",
          "description": "Files with more lines than this are not sent whole."
        },
        "logiclens.secrets.action": {
          "type": "string",
          "enum": [
            "skip-lines",
            "refuse-file"
          ],
          "enumDescriptions": [
            "Replace each line with a possible secret by a marker and send the rest.",
            "Send nothing when a possible secret is found."
          ],
          "default": "skip-lines",
          "scope": "application",
          "description": "What to do when the local secret scan finds a possible secret. The scan cannot be turned off."
        },
        "logiclens.debug.logPrompts": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Log prompts and responses (with secrets redacted) to the LogicLens output channel. Off by default."
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm build:host && pnpm build:webview",
    "build:host": "node esbuild.mjs",
    "build:release": "node esbuild.mjs --production && pnpm build:webview",
    "build:webview": "vite build --config webview/vite.config.mts",
    "watch": "node esbuild.mjs --watch",
    "watch:webview": "vite build --config webview/vite.config.mts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit && svelte-check --tsconfig webview/tsconfig.json --fail-on-warnings && tsc -p test/integration/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "pretest:integration": "pnpm build && tsc -p test/integration/tsconfig.json",
    "test:integration": "vscode-test",
    "package": "pnpm build:release && vsce package --no-dependencies --no-rewrite-relative-links --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "ignore": "^7.0.14",
    "markdown-it": "^15.0.3",
    "picomatch": "^4.0.7",
    "svelte": "^5.57.3"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "LogicLens never sends code from a restricted workspace. Trust the workspace to explain code."
    }
  }
}
